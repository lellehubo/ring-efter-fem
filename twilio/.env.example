# Kopiera till .env (som aldrig committas) och fyll i. Se README.md.

# Kontot (används när du driftsätter)
ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AUTH_TOKEN=

# API-nyckel (Konsolen: Account > API keys & tokens > Create API key, typ Standard)
API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
API_KEY_SECRET=

# TwiML-appen vars röstadress pekar på /ring
TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Numret som syns hos den uppringda: en verifierad mobil eller ett eget Twilio-nummer, +46…
CALLER_ID=+46700000000

# Telefonnyckeln som klistras in i Bänkgrannen. Minst 16 tecken, slumpad.
# Skapa till exempel med: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
BANK_KEY=

# Vilka sidor som får hämta nyckel och lista (kommaseparerat)
ALLOWED_ORIGINS=https://lellehubo.github.io

# Telefonlistan. Bara personer som i förväg sagt ja (datumet i samtycke).
# Kontakter utan giltigt nummer eller utan samtycke tas bort automatiskt.
# Inga källor, uppgiftslämnare eller personer i pågående granskningar.
CONTACTS='[{"id":"lelle","namn":"Lelle","nummer":"+46700000000","roll":"föreläsaren själv, för test","arende":"Ett provsamtal","samtycke":"2026-10-04"}]'
